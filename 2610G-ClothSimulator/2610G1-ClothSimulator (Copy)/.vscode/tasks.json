{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: build",
            "type": "cmake",
            "command": "build",
            "targets": [
                "all"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Cloth: configure optimized",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build/RelWithDebInfo",
                "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
                "-DCMAKE_CUDA_COMPILER=/usr/local/cuda/bin/nvcc",
                "-DCMAKE_CUDA_ARCHITECTURES=89"
            ],
            "problemMatcher": []
        },
        {
            "label": "Cloth: build optimized",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/RelWithDebInfo",
                "--parallel",
                "2"
            ],
            "dependsOn": "Cloth: configure optimized",
            "problemMatcher": []
        },
        {
            "label": "Cloth: run optimized (no debugger)",
            "type": "process",
            "command": "${workspaceFolder}/build/RelWithDebInfo/ClothSimulator",
            "args": [
                "simulate",
                "conf/dress-blue.json",
                "--gpu"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "CUDA_LAUNCH_BLOCKING": "0",
                    "__NV_PRIME_RENDER_OFFLOAD": "1",
                    "__GLX_VENDOR_LIBRARY_NAME": "nvidia"
                }
            },
            "dependsOn": "Cloth: build optimized",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false
            }
        }
    ]
}
