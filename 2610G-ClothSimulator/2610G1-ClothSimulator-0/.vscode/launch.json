{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug ClothSimulator",
            "type": "cuda-gdb",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/ClothSimulator",
            "args": [
                "simulate",
                "conf/dress-blue.json",
                "--gpu"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "debuggerPath": "/usr/local/cuda/bin/cuda-gdb",
            "breakOnLaunch": false,
            "environment": [
                {
                    "name": "CUDA_LAUNCH_BLOCKING",
                    "value": "1"
                },
                {
                    "name": "DEBUGINFOD_URLS",
                    "value": ""
                },
                {
                    "name": "__NV_PRIME_RENDER_OFFLOAD",
                    "value": "1"
                },
                {
                    "name": "__GLX_VENDOR_LIBRARY_NAME",
                    "value": "nvidia"
                }
            ],
            "initCommands": [
                "set debuginfod enabled off"
            ],
            "internalConsoleOptions": "openOnSessionStart"
        }
    ]
}
