{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build NURBS with NVCC",
      "type": "shell",
      "command": "mkdir -p build && /usr/local/cuda/bin/nvcc *.cu -o build/NURBS -std=c++17 -arch=sm_86 -rdc=true -g -G -DFIX1 -Xptxas=-dlcm=ca -lcublas -lcusparse",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
